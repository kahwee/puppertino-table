{
  "name": "puppertino-table",
  "version": "0.13.0",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "license": "MIT",
  "description": "Composable Finder-style React components and accessible TanStack tables, styled with Puppertino.",
  "repository": {
    "type": "git",
    "url": "https://github.com/kahwee/puppertino-table.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts && node --test tests/release.test.mjs",
    "test:browser": "tsx scripts/check-browser.ts && pnpm test:hydration",
    "test:hydration": "tsx scripts/check-hydration.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:demo && pnpm build:storybook && pnpm test:browser && pnpm test:package",
    "storybook": "storybook dev -p 6006 --no-open",
    "build:storybook": "storybook build --disable-telemetry",
    "prepack": "node scripts/build.mjs",
    "test:package": "node scripts/check-package.mjs",
    "lint": "biome ci . --error-on-warnings",
    "format": "biome check --write .",
    "profile:pointer": "tsx scripts/profile-pointer.ts",
    "profile:columns": "tsx scripts/profile-columns.ts",
    "capture:readme": "pnpm build:storybook && node scripts/capture-readme.mjs",
    "profile:collections": "tsx scripts/profile-collections.ts"
  },
  "peerDependencies": {
    "@codedgar/puppertino": "^2.0.0",
    "@tanstack/react-table": "9.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@codedgar/puppertino": "2.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-themes": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tanstack/react-table": "9.3.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.14.0",
    "playwright": "^1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@12.11.2",
  "homepage": "https://kahwee.github.io/puppertino-table/",
  "bugs": {
    "url": "https://github.com/kahwee/puppertino-table/issues"
  },
  "keywords": [
    "react",
    "table",
    "tanstack",
    "puppertino",
    "accessible",
    "resizable",
    "typescript"
  ],
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@tanstack/react-store": "0.11.2"
  }
}
